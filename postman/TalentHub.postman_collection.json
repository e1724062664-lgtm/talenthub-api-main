{
  "info": {
    "name": "TalentHub API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Candidates",
      "item": [
        {
          "name": "Listar candidatos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El código de estado es 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('La respuesta es un arreglo', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/candidates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "candidates"
              ]
            }
          }
        },
        {
          "name": "Ver un candidato",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El código de estado es 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "candidates",
                "{{candidateId}}"
              ]
            }
          }
        },
        {
          "name": "Crear candidato",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El código de estado es 201', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Devuelve el candidato con su id', () => {",
                  "  pm.expect(pm.response.json().id).to.be.a('number');",
                  "});",
                  "// Guarda el id del candidato creado para usarlo en Editar y Eliminar.",
                  "pm.collectionVariables.set('candidateId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "candidates"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lucía Paredes\",\n  \"email\": \"lucia.paredes@example.com\",\n  \"city\": \"Cuenca\",\n  \"experienceYears\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Editar candidato",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El código de estado es 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Devuelve los datos actualizados', () => {",
                  "  pm.expect(pm.response.json().city).to.eql('Loja');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "candidates",
                "{{candidateId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lucía Paredes\",\n  \"email\": \"lucia.paredes@example.com\",\n  \"city\": \"Loja\",\n  \"experienceYears\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar candidato",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('El código de estado es 204', () => {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/candidates/{{candidateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "candidates",
                "{{candidateId}}"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "candidateId",
      "value": "1"
    }
  ]
}